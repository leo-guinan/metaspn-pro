# Production Environment Variables Template
# Copy this file to /etc/metaspn/.env.prod on your server
# DO NOT commit actual secrets to the repository

# Database Configuration (Neon.tech)
# Get connection string from Neon.tech dashboard
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Chroma Cloud (Vector Database)
# Get these values from Chroma Cloud dashboard
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=your_tenant_uuid_here
CHROMA_DATABASE=metaspn
# Note: CHROMA_API_URL is only needed for self-hosted Chroma (not Chroma Cloud)

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NextAuth (use same origin as FRONTEND_URL)
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET

# JWT Authentication
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
JWT_EXPIRES_IN=7d

# OAuth & Redirects (required for login)
# FRONTEND_URL must be your production origin (e.g. https://pro.metaspn.network).
# If unset or localhost in production, OAuth will redirect users to localhost and fail.
# GITHUB_CALLBACK_URL / TWITTER_CALLBACK_URL default to ${FRONTEND_URL}/api/auth/.../callback
# when unset. Set explicitly only if your API is on a different origin.

FRONTEND_URL=https://pro.metaspn.network

# Twitter OAuth – register this exact callback in your Twitter app
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
# TWITTER_CALLBACK_URL=https://pro.metaspn.network/api/auth/twitter/callback

# GitHub OAuth – register this exact callback in your GitHub OAuth app
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
# GITHUB_CALLBACK_URL=https://pro.metaspn.network/api/auth/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=CHANGE_ME_GENERATE_STRONG_SECRET

# GitHub Push Cron (optional, default: every 6 hours)
# GITHUB_PUSH_CRON=0 */6 * * *

# Frontend – base URL only (no /api). Frontend requests go to ${NEXT_PUBLIC_API_URL}/api/...
NEXT_PUBLIC_API_URL=https://pro.metaspn.network
NEXTAUTH_URL=https://pro.metaspn.network

# Game Classifier (optional; used by Mastra tools)
# When using docker-compose.prod.managed.yml, default is http://game-classifier:5000
# GAME_CLASSIFIER_URL=http://game-classifier:5000

# Note: Database backups handled by Neon.tech automatically
# No local backup configuration needed

# Redis (optional, for caching)
# REDIS_URL=redis://redis:6379
