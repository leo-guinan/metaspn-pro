# Production Environment Variables Template
# Copy this file to /etc/metaspn/.env.prod on your server
# DO NOT commit actual secrets to the repository

# Database Configuration
POSTGRES_USER=metaspn
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=metaspn
DATABASE_URL=postgresql://metaspn:CHANGE_ME_STRONG_PASSWORD@postgres:5432/metaspn

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# NextAuth
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET

# JWT Authentication
JWT_SECRET=CHANGE_ME_GENERATE_STRONG_SECRET
JWT_EXPIRES_IN=7d

# Twitter OAuth (Production)
TWITTER_CLIENT_ID=your_twitter_client_id
TWITTER_CLIENT_SECRET=your_twitter_client_secret
TWITTER_CALLBACK_URL=https://your-domain.com/api/auth/twitter/callback

# GitHub OAuth (Production)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://your-domain.com/api/auth/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=CHANGE_ME_GENERATE_STRONG_SECRET

# GitHub Push Cron (optional, default: every 6 hours)
# GITHUB_PUSH_CRON=0 */6 * * *

# Frontend Configuration
FRONTEND_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://your-domain.com/api

# Backup Configuration
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# Redis (optional, for caching)
# REDIS_URL=redis://redis:6379
